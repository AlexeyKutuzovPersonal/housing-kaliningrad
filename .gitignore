# Данные задачи в репозиторий не едут: это десятки мегабайт выгрузок,
# которые пересобираются из источников, и профили браузера с живыми
# куками сессий. В публикуемом репозитории им не место даже приватном.
data/
.browser-profile*/
node_modules/

# Датированные сборки — локальный архив. В репозиторий попадает ровно
# одна страница: public/index.html, её кладёт туда генератор.
dashboard_*.html
dashboard.html

# Секреты Cloudflare. Токен синхронизации живёт в переменных окружения
# проекта Pages и в секретах GitHub, но не в файле рядом с кодом.
.dev.vars
.wrangler/

# Токен синхронизации. Лежит рядом с кодом только для локальных
# сборок; в бою он приходит из переменных окружения проекта Pages.
.sync-token
