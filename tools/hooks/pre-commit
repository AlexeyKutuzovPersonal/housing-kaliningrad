#!/bin/sh
# ============================================================
# pre-commit — проставляет в странице момент выкладки.
#
# Срабатывает ТОЛЬКО когда в коммит попадает сам public/index.html.
# Правка README, схемы или ночной снимок разметки страницу не меняют,
# и двигать отметку не должны: отметка, которая шевелится без причины,
# перестаёт что-либо значить на второй неделе.
#
# Хук лежит В РЕПОЗИТОРИИ, а не в .git/hooks — иначе он существует в
# одном экземпляре на одной машине и теряется при клонировании молча.
# Включается один раз на клон:
#
#     git config core.hooksPath tools/hooks
#
# Отсутствие node здесь — ОШИБКА, а не повод пропустить штамп. Молча
# незаштампованная страница выглядит свежей и не является ею; это ровно
# тот сорт тишины, ради которого хук и написан.
# ============================================================

set -e

PAGE="public/index.html"

# Страница в этом коммите не участвует — отметке двигаться не с чего.
if ! git diff --cached --name-only | grep -qx "$PAGE"; then
  exit 0
fi

# Node на этой машине портативный и в PATH его нет. Порядок поиска:
# то, что в PATH → node24 из LOCAL TOOLS (его же зовёт cf.cmd) →
# портативный из соседней задачи.
NODE=""
if command -v node >/dev/null 2>&1; then
  NODE="node"
else
  for c in \
    "/d/Claude Cowork/CODE/LOCAL TOOLS/node24/node.exe" \
    "/d/Claude Cowork/CODE/PROJECTS/Job Search/agents/JS_Scraper/node-portable/node.exe"
  do
    if [ -x "$c" ]; then NODE="$c"; break; fi
  done
fi

if [ -z "$NODE" ]; then
  echo "pre-commit: не нашёл node — отметку выкладки поставить нечем." >&2
  echo "  Искал: node в PATH, LOCAL TOOLS\\node24, node-portable в Job Search." >&2
  echo "  Коммит остановлен намеренно: страница без отметки выглядит свежей." >&2
  exit 1
fi

"$NODE" tools/stamp-updated.js "$PAGE" || exit 1

# Штамп поставлен уже ПОСЛЕ индексации, поэтому файл переиндексируется.
# Без этой строки в коммит уедет версия без отметки, а в рабочей копии
# останется отличие — и следующий коммит будет выглядеть «пустым».
git add "$PAGE"
